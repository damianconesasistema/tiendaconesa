// Schema para la tienda de Sanitarios Conesa.
// Pedidos + productos + clientes. Admin con cookies HMAC existentes.
// SQLite para desarrollo, Postgres en Railway en produccion.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id @default(cuid())
  itemId        String   @unique // ID original interno (MLA12345...)
  sku           String?  @unique // Codigo que el admin usa para identificar el articulo
  title         String
  description   String?  // Opcional, para la ficha
  category      String   // sanitarios, griferia, banera, etc.
  price         Int      // en pesos argentinos (sin decimales)
  salePrice     Int?     // precio con descuento (opcional)
  stock         Int      @default(0)
  active        Boolean  @default(true)
  featured      Boolean  @default(false) // Aparece en destacados del home
  imageUrl      String?  // Override: por defecto usa /categories/{category}.jpg
  memo          String?  // Ayuda memoria del admin (proveedor, remito, cotizacion, etc.)
  shippingType  String?  @default("ambos") // ambos | retiro | envio | gratis
  locked        Boolean  @default(false) // Candado: bloquea edicion y borrado
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orderItems    OrderItem[]
  priceHistory  PriceHistory[]
  images        ProductImage[]

  @@index([category])
  @@index([active])
  @@index([featured])
}

// Imagenes del producto guardadas en la DB (bytes). Hasta N por producto
// (galeria). La de position mas baja es la principal (la que se muestra en
// las cards). Se sirven por GET /api/productos/[itemId]/imagen (principal)
// y GET /api/productos/img/[id] (una puntual). Evita depender del
// filesystem de Railway (efimero / de solo lectura en runtime).
model ProductImage {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  data        Bytes    // contenido binario de la imagen
  contentType String   // image/jpeg, image/png, image/webp
  position    Int      @default(0) // orden en la galeria; menor = principal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, position])
}

// Historial de precios: se registra cada vez que cambia price o salePrice.
// Permite ver a cuanto se vendio antes y detectar subas del proveedor.
model PriceHistory {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  price      Int      // precio normal al momento del cambio
  salePrice  Int?     // oferta al momento del cambio (si existia)
  note       String?  // etiqueta opcional ("suba proveedor", "liquidacion", etc.)
  source     String?  // de donde vino el cambio: manual, excel, bulk, seed
  createdAt  DateTime @default(now())

  @@index([productId, createdAt])
}

model Customer {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  dni       String
  email     String
  phone     String
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dni])
  @@index([email])
}

// Estados: pendiente, confirmado, en_preparacion, en_entrega, entregado, cancelado
model Order {
  id           String      @id @default(cuid())
  number       Int         @unique // numero legible (#1, #2, ...) asignado en codigo
  status       String      @default("pendiente")
  customer     Customer    @relation(fields: [customerId], references: [id])
  customerId   String
  items        OrderItem[]
  shipping     String      // "retiro" | "envio"
  locality     String?     // solo si shipping = envio
  street       String?
  streetNumber String?
  reference    String?
  notes        String?
  subtotal     Int         // suma de items
  shippingCost Int         @default(0)
  total        Int         // subtotal + shippingCost
  paidAt       DateTime?   // marca manual cuando el admin confirma pago

  // --- Pago online (Payway / Decidir) ---
  // paymentMethod: "transferencia" | "efectivo_local" | "tarjeta"
  paymentMethod       String?
  // Estado especifico de Payway: approved | rejected | pending | error | null
  paywayStatus        String?
  paywayPaymentId     String?  // id devuelto por Payway (para refunds / tracking)
  paywaySiteTxId      String?  // site_transaction_id que mandamos
  paywayAuthCode      String?  // codigo de autorizacion (POS)
  paywayCardBrand     String?  // visa, master, amex, etc.
  paywayCardLast4     String?  // ultimos 4 digitos
  paywayCardInstallments Int?  // cuotas elegidas
  paywayErrorCode     String?  // codigo de error en caso de rechazo
  paywayErrorMessage  String?  // mensaje de error en caso de rechazo
  paywayRawResponse   String?  // JSON crudo de la respuesta (para debug/soporte)

  // --- Pago online (MercadoPago - Checkout Pro) ---
  mpPreferenceId  String?  // id de la preferencia creada
  mpPaymentId     String?  // id del pago en MercadoPago
  mpStatus        String?  // approved | pending | in_process | rejected | refunded | cancelled
  mpStatusDetail  String?  // detalle (accredited, cc_rejected_*, etc.)
  mpPaymentType   String?  // credit_card, debit_card, ticket, account_money, etc.
  mpRawResponse   String?  // JSON crudo (debug/soporte)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  title     String  // snapshot al momento de la venta
  price     Int     // snapshot (en caso que cambie despues)
  qty       Int

  @@index([orderId])
}
