// Schema para la tienda de Sanitarios Conesa.
// Pedidos + productos + clientes. Admin con cookies HMAC existentes.
// SQLite para desarrollo, Postgres en Railway en produccion.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Configuracion editable desde el panel, sin tener que tocar codigo ni
// variables de Railway. Clave/valor para no migrar la tabla cada vez que
// aparece un ajuste nuevo.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Product {
  id           String          @id @default(cuid())
  itemId       String          @unique // ID original interno (MLA12345...)
  sku          String?         @unique // Codigo que el admin usa para identificar el articulo
  title        String
  description  String? // Opcional, para la ficha
  category     String // sanitarios, griferia, banera, etc.
  // El subrubro dentro del rubro ("lavatorio" dentro de griferia). Es del
  // articulo, no del local: un juego de lavatorio es de lavatorio en las dos
  // sucursales. La lista de cada rubro esta en src/lib/subrubros.ts.
  subcategory  String?
  brand        String? // slug de marca (fv, ferrum, piazza...). Ver src/lib/marcas.ts
  // Como lo llama el sistema de Conesa ("3674"). Sirve para importar la
  // lista tal cual sale de ahi sin tener que adivinar por el prefijo del
  // codigo del sitio.
  codigoSistema String?
  // El codigo con que la marca nombra al producto ("AGAR0IMP 13", "0207/B1").
  // Con este se lo busca en la pagina de la marca. Ver migracion 42.
  codigoFabricante String?
  price        Int // en pesos argentinos (sin decimales)
  salePrice    Int? // precio con descuento (opcional)
  stock        Int             @default(0)
  active       Boolean         @default(true)
  featured     Boolean         @default(false) // Aparece en destacados del home
  imageUrl     String? // Override: por defecto usa /categories/{category}.jpg
  memo         String? // Ayuda memoria del admin (proveedor, remito, cotizacion, etc.)
  shippingType String?         @default("ambos") // ambos | retiro | envio | gratis
  locked       Boolean         @default(false) // Candado: bloquea edicion y borrado
  views        Int             @default(0) // Visitas a la ficha. Las cuenta el navegador, una por sesion.
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  orderItems   OrderItem[]
  priceHistory PriceHistory[]
  sucursales   BranchProduct[]
  images       ProductImage[]

  @@index([category])
  @@index([subcategory])
  @@index([brand])
  @@index([active])
  @@index([featured])
  @@index([codigoSistema])
  @@index([views])
}

// Imagenes del producto guardadas en la DB (bytes). Hasta N por producto
// (galeria). La de position mas baja es la principal (la que se muestra en
// las cards). Se sirven por GET /api/productos/[itemId]/imagen (principal)
// y GET /api/productos/img/[id] (una puntual). Evita depender del
// filesystem de Railway (efimero / de solo lectura en runtime).
model ProductImage {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  data        Bytes // contenido binario de la imagen
  contentType String // image/jpeg, image/png, image/webp
  position    Int      @default(0) // orden en la galeria; menor = principal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, position])
}

// Historial de precios: se registra cada vez que cambia price o salePrice.
// Permite ver a cuanto se vendio antes y detectar subas del proveedor.
model PriceHistory {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  price     Int // precio normal al momento del cambio
  salePrice Int? // oferta al momento del cambio (si existia)
  note      String? // etiqueta opcional ("suba proveedor", "liquidacion", etc.)
  source    String? // de donde vino el cambio: manual, excel, bulk, seed
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model Customer {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  dni       String
  email     String
  phone     String
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dni])
  @@index([email])
}

// Estados: pendiente, confirmado, en_preparacion, en_entrega, entregado, cancelado
model Order {
  id           String      @id @default(cuid())
  number       Int         @unique // numero legible (#1, #2, ...) asignado en codigo
  status       String      @default("pendiente")
  customer     Customer    @relation(fields: [customerId], references: [id])
  customerId   String
  items        OrderItem[]
  shipping     String // "retiro" | "envio"
  locality     String? // solo si shipping = envio
  // La provincia y el codigo postal se piden cuando el envio es fuera de
  // la zona del local. El CP ademas es lo que mas adelante decide que
  // sucursal atiende el pedido: por localidad escrita a mano no se puede.
  province     String?
  postalCode   String?
  street       String?
  streetNumber String?
  // Piso y departamento. Aparte de la calle porque es lo primero que le
  // falta al repartidor cuando llega a un edificio.
  floor        String?
  reference    String?
  notes        String?
  // La zona del mapa de Mercado Envios Flex que eligio el cliente
  // ("La Matanza", "CABA"). Buenos Aires solo envia dentro de ese mapa
  // (src/lib/zona-envio.ts); va en la etiqueta para el repartidor.
  zonaEnvio    String?
  // Si salio con envio gratis: compra desde el tope del local y dentro del
  // mapa. Se guarda y no se recalcula, porque el tope puede cambiar despues
  // y lo prometido al cliente tiene que seguir siendo lo que se le prometio.
  envioGratis  Boolean     @default(false)
  // Como sale y su seguimiento: van en el mail "esta en camino" (migracion 43).
  transporte      String? // jym | flete | andreani | oca | correo | viacargo | cruzdelsur | otro
  seguimiento     String? // numero de seguimiento
  linkSeguimiento String? // link directo, si el transporte lo da
  // Los mails que se le mandaron al cliente por los cambios de estado (JSON:
  // [{tipo, fecha, a, ok, error}]).
  avisos          String?

  // De que sucursal es este pedido: el local que cobra y que factura.
  //
  // Se guarda aca porque despues ya no hay de donde sacarlo. El aviso de
  // pago lo manda MercadoPago desde sus servidores y ahi no viene nuestro
  // dominio; el boton Facturar del panel tampoco sabe por donde entro el
  // cliente. Sin este dato, un pedido de Buenos Aires se cobraria en la
  // cuenta de Traslasierra y se facturaria con el CUIT de Traslasierra.
  //
  // Puede estar vacio: los pedidos que ya estaban cargados el dia que se
  // agrego la columna no lo tienen. Para esos se usa la sucursal que vende,
  // que mientras venda una sola es la misma de siempre.
  branch       Branch?     @relation(fields: [branchId], references: [id])
  branchId     String?

  subtotal     Int // suma de items
  shippingCost Int         @default(0)
  surcharge    Int         @default(0) // recargo por pagar con tarjeta
  total        Int // subtotal + shippingCost + surcharge
  paidAt       DateTime? // marca manual cuando el admin confirma pago

  // --- Pago online (Payway / Decidir) ---
  // paymentMethod: "transferencia" | "efectivo_local" | "tarjeta"
  paymentMethod          String?
  // Estado especifico de Payway: approved | rejected | pending | error | null
  paywayStatus           String?
  paywayPaymentId        String? // id devuelto por Payway (para refunds / tracking)
  paywaySiteTxId         String? // site_transaction_id que mandamos
  paywayAuthCode         String? // codigo de autorizacion (POS)
  paywayCardBrand        String? // visa, master, amex, etc.
  paywayCardLast4        String? // ultimos 4 digitos
  paywayCardInstallments Int? // cuotas elegidas
  paywayErrorCode        String? // codigo de error en caso de rechazo
  paywayErrorMessage     String? // mensaje de error en caso de rechazo
  paywayRawResponse      String? // JSON crudo de la respuesta (para debug/soporte)

  // --- Pago online (MercadoPago - Checkout Pro) ---
  mpPreferenceId String? // id de la preferencia creada
  mpPaymentId    String? // id del pago en MercadoPago
  mpStatus       String? // approved | pending | in_process | rejected | refunded | cancelled
  mpStatusDetail String? // detalle (accredited, cc_rejected_*, etc.)
  mpPaymentType  String? // credit_card, debit_card, ticket, account_money, etc.
  mpRawResponse  String? // JSON crudo (debug/soporte)

  // --- Facturacion electronica (ARCA / AFIP) ---
  // Se completan cuando el admin aprieta "Facturar" y ARCA devuelve el CAE.
  // Si cbteNro esta cargado, el pedido ya esta facturado y no se vuelve a emitir.
  cbteTipo    Int? // 1 = Factura A, 6 = Factura B, 11 = Factura C
  ptoVta      Int? // punto de venta usado (6 = TIENDA ONLINE)
  cbteNro     Int? // numero de comprobante que asigno ARCA
  cae         String? // codigo de autorizacion electronico
  caeVto      DateTime? // vencimiento del CAE
  facturadoAt DateTime? // cuando se emitio
  facturaNeto Int? // neto gravado en pesos (sin IVA)
  facturaIva  Int? // IVA 21% en pesos
  afipRaw     String? // respuesta cruda de ARCA (debug y respaldo)

  // --- Nota de credito (anulacion de la factura de arriba) ---
  ncTipo   Int? // 3 = NC A, 8 = NC B
  ncNro    Int?
  ncCae    String?
  ncCaeVto DateTime?
  ncAt     DateTime?
  ncMotivo String? // lo escribe el admin al anular
  ncRaw    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([branchId])
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  title     String // snapshot al momento de la venta
  price     Int // snapshot (en caso que cambie despues)
  qty       Int

  @@index([orderId])
}

// Sucursal: cada local que vende, con su propio titular.
//
// Traslasierra y Buenos Aires facturan con CUIT distinto, asi que cada una
// tiene sus datos fiscales. Las claves de ARCA y MercadoPago NO viven aca:
// quedan en variables de entorno separadas por `slug`, para no guardar una
// clave privada en la base.
model Branch {
  id     String  @id @default(cuid())
  slug   String  @unique // traslasierra | bsas. Es la clave de las credenciales.
  // La tienda de cada sucursal vive en su propio subdominio y de ahi sale
  // todo: que CUIT factura, a que cuenta entra la plata, que precios se
  // muestran. El dominio no se equivoca; preguntarselo al cliente si.
  subdominio String? @unique // traslasierra | balvanera
  name   String // Como se muestra: "Traslasierra"
  active Boolean @default(true)
  // Si en su subdominio se puede comprar. Es distinto de active: una
  // sucursal puede estar publicada en el sitio (direccion, mapa, telefono)
  // sin tener la tienda abierta. Mientras no tenga su propio MercadoPago y
  // su propio certificado de ARCA, vender ahi seria cobrar y facturar a
  // nombre del otro contribuyente.
  tiendaActiva Boolean @default(true)
  // Si esta sucursal tiene tienda online. Distinto de tiendaActiva, que es
  // abrir y cerrar la puerta un rato: esto dice si la tienda existe. Una
  // sucursal sin tienda online sigue apareciendo como local (direccion,
  // horarios, redes), pero no en el panel de productos ni en nada de
  // comprar online. Damian, 16/11/2026: "Traslasierra se menciona como
  // sucursal, pero no la tienda, solo la de Buenos Aires"; "si volvemos a
  // activarla en algun momento la prendemos" -> se vuelve a poner en true.
  tiendaOnline Boolean @default(true)
  orden  Int     @default(0) // En que orden se listan

  // Datos del titular: van en la factura, el pie del sitio y los mails.
  razonSocial String?
  cuit        String?
  iibb        String?
  inicioAct   String?
  // Codigo del QR de Data Fiscal (F960/D). Es propio de cada CUIT y
  // domicilio, y mostrarlo en la tienda es obligatorio.
  afipQr      String?

  // Contacto y domicilio del local
  address    String?
  city       String?
  province   String?
  postalCode String?
  // Para el punto en el mapa de la ficha de Google. Vacias si no se saben:
  // un punto mal puesto manda al cliente a otra cuadra.
  lat        Float?
  lng        Float?
  phone      String?
  whatsapp   String?
  email      String?
  // Cada local tiene su Instagram y es por donde le escribe la gente.
  instagram  String?

  // Horarios tal cual se muestran. Texto libre porque cada local tiene su
  // propia vuelta (corrido, cortado, sabados a la mañana).
  hours      String?

  // Zona de reparto. El cliente escribe su codigo postal y con esto se
  // decide que sucursal lo atiende; por IP no sirve, en el valle la
  // conexion sale por Buenos Aires y miente.
  //
  // `codigosPostales` es una lista separada por comas, editable desde el
  // panel para poder sumar pueblos sin tocar codigo.
  codigosPostales String?
  // La que cubre el resto del pais: atiende cualquier CP que no matchee
  // con ninguna zona. Tiene que haber exactamente una.
  cubreTodoElPais Boolean @default(false)

  // Que envia esta sucursal, escrito por el que vende. Es distinto de
  // cubreTodoElPais: esa casilla decide a quien le entra el pedido, esto es
  // lo que se le promete al cliente. Mezclarlos hizo que Balvanera publicara
  // "Envios a todo el pais" cuando por ahora solo cubre AMBA.
  zonaEnvio       String?

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  productos BranchProduct[]
  pedidos   Order[]

  @@index([active])
}

// Precio, oferta y stock de un producto EN una sucursal.
//
// El producto (titulo, fotos, descripcion, categoria) es uno solo y se
// carga una vez; lo que cambia por local es esto. Asi una lista de precios
// nueva no hay que cargarla dos veces.
model BranchProduct {
  id        String   @id @default(cuid())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId  String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  price     Int
  salePrice Int?
  stock     Int      @default(0)
  // Se puede apagar en una sucursal y dejarlo prendido en la otra.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
}

// Los usuarios del panel, uno por persona (migracion 44). "admin" no esta
// aca: es el principal, con la contrasena de /etc/conesa.env. Ver
// src/lib/usuarios.ts.
model AdminUser {
  id            String    @id @default(cuid())
  username      String    @unique // en minusculas, sin espacios
  nombre        String
  passwordHash  String // scrypt$sal$hash: nunca la contrasena en si
  activo        Boolean   @default(true)
  // La contrasena se la puso admin (al crearlo o al resetearla): al entrar,
  // el panel le pide que elija la suya (migracion 46).
  debeCambiarClave Boolean @default(false)
  // Las partes del panel que ve, separadas por coma; null = todo
  // (src/lib/permisos.ts, migracion 47).
  permisos      String?
  ultimoIngreso DateTime?
  // La ultima vez que abrio una pantalla del panel ("conectado ahora").
  ultimaActividad DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // ---- Sistema Punto (migracion 54, src/lib/punto-permisos.ts). Damian,
  // 22/11/2026: "me falta el panel de usuarios donde ahi yo seleccione que
  // area puede ver cada usuario o a que tiene acceso".
  // Las areas y acciones de Punto que puede usar, separadas por coma;
  // null = todo (asi los que ya existen siguen como hasta hoy).
  punto         String?
  // La sucursal con la que vende: "srl", "cnc" o "tsl"; null = elige
  // cualquiera, como hasta hoy.
  sucursal      String?
  // Administra los usuarios de Punto (src/app/sistema/usuarios).
  adminPunto    Boolean   @default(false)
}

// Que miran y que buscan los que entran a la tienda, dia por dia
// (migracion 45). Damian, 19/11/2026: "me podes tagear cada producto para
// saber que miran o buscan los que entran?". Lo de ellos mismos no cuenta
// ("en lo que es el panel de productos no cuentes ahi porque somos
// nosotros"): ver src/lib/miradas.ts. Una fila por dia y no una por visita:
// alcanza para ver la ultima semana o el ultimo mes y la tabla no crece sin
// fin. El dia es el de Argentina.
model VistaDiaria {
  itemId   String // Product.itemId
  dia      DateTime @db.Date
  cantidad Int      @default(0)

  @@id([itemId, dia])
  @@index([dia])
}

model BusquedaDiaria {
  termino    String // en minusculas, sin espacios de mas
  dia        DateTime @db.Date
  cantidad   Int      @default(0)
  // Cuantos productos encontro la ultima vez que alguien lo busco. En 0 es
  // algo que la gente busca y la tienda no tiene (o no sabe encontrar).
  resultados Int      @default(0)

  @@id([termino, dia])
  @@index([dia])
}

// Registro de actividad del panel (migracion 48). Damian, 19/11/2026:
// "quiero que cada modificacion o lo que se haga en el panel quede asentado
// con el usuario que toco". Lo escribe src/lib/actividad.ts.
/// Lo que encontro el comparador de precios, un renglon por producto
/// (src/lib/comparador.ts). Hasta V.0.99.54 iba todo junto en el Setting
/// "comparador_precios" y si dos buscaban a la vez uno pisaba al otro.
model ComparacionPrecio {
  itemId String   @id
  fecha  DateTime
  /// La Comparacion entera (fecha, buscado, resultados, fallaron...).
  datos  Json
}

model Actividad {
  id      String   @id @default(cuid())
  fecha   DateTime @default(now())
  usuario String
  accion  String
  detalle String?

  @@index([fecha])
  @@index([usuario])
}

/// Lo que se emite en el sistema Punto (migracion 50): presupuestos,
/// facturas, remitos, pedidos internos y ventas sin comprobante. Damian,
/// 21/11/2026: "el presupuesto que emiti donde queda? deberian mostrarse
/// todos los presupuestos y ver lo que estuve presupuestando o facturando".
/// Las facturas de Punto todavia NO van a ARCA: no tienen CAE ni valen como
/// comprobante fiscal. Lo escribe src/lib/punto-documentos.ts. No se borra.
model PuntoDocumento {
  id        String   @id @default(cuid())
  /// Lo genera el navegador al emitir: si el pedido se repite (doble clic,
  /// corte de conexion), devuelve el mismo documento y no gasta otro numero.
  idLocal   String   @unique
  createdAt DateTime @default(now())
  /// presupuesto | factura | remito | pedido-interno | sin-comprobante
  tipo      String
  /// Como se eligio en la venta: "02.Factura B", "03.Presupuesto".
  comp      String
  /// A, B, X, R o P. Null en la venta sin comprobante.
  letra     String?
  /// srl | cnc | tsl
  sucursal  String
  pv        String
  numero    Int?
  /// El P-NNNN del tramite.
  pedido    Int
  /// El usuario que entro (de la sesion) y el vendedor elegido en la venta.
  usuario   String
  vendedor  String
  puesto    String
  cliente   String
  /// En pesos, con centavos: el ticket los tiene (el recargo de tarjeta).
  total     Float
  /// El presupuesto del que salio esta venta, si salio de uno.
  origenId  String?
  /// Los renglones con el precio y el costo de ese momento, el cliente, la
  /// forma de pago, el descuento, el recargo y el deposito.
  datos     Json
  /// Eliminado desde Comprobantes (migracion 51): no se borra, se marca.
  /// Sale de la lista y de la Caja; se ve en "Eliminados" y se recupera.
  eliminadoEn  DateTime?
  eliminadoPor String?

  @@unique([sucursal, tipo, letra, numero])
  @@index([createdAt])
  @@index([tipo, createdAt])
  @@index([origenId])
}

/// Los numeradores de Punto (migracion 50): el ultimo numero usado de cada
/// serie ("srl:B", "tsl:X", "pedido"). Sube adentro de la misma transaccion
/// que crea el documento, asi dos puestos nunca sacan el mismo.
model PuntoNumerador {
  clave  String @id
  ultimo Int    @default(0)
}

/// Los proveedores del sistema Punto (migracion 52), traidos del Excel que
/// exporta GlobalBluePoint: los de Buenos Aires y los de Traslasierra en una
/// sola lista. Damian, 22/11/2026: "este es el listado de proveedores del
/// sistema tanto de buenos aires como de traslasierra". Un renglon por
/// proveedor (no un Setting JSON): mas adelante cada uno lleva su cadena de
/// descuentos. Lo escribe src/lib/punto-proveedores.ts.
model PuntoProveedor {
  id              String    @id @default(cuid())
  /// El ID de GBP: con ese se lo reconoce al volver a importar el Excel.
  /// Null en los que se dan de alta en Punto (migracion 55): en Postgres
  /// muchos NULL no chocan en un unico.
  gbpId           Int?      @unique
  /// Solo numeros, sin guiones. Del Excel de GBP, los 11 del CUIT (vacio si
  /// no tenia 11). Dado de alta a mano en Punto, hasta 11 (un CUIT, que pasa
  /// el digito verificador, o un DNI).
  cuit            String
  razonSocial     String
  /// Como viene de GBP: "IVA Responsable Inscripto", "Responsable Monotributo"...
  claseFiscal     String
  domicilio       String
  localidad       String
  provincia       String
  pais            String
  telefono        String
  /// Como viene de GBP: "01-Contado", "02-Cheque 30 dias"...
  condicionCompra String
  /// La moneda de su cuenta corriente: ARS | USD
  moneda          String
  /// La columna "Inactivo" de GBP. No se borra: se marca.
  inactivo        Boolean   @default(false)
  /// La cadena de descuentos del proveedor (para mas adelante). Volver a
  /// importar el Excel no la toca.
  cadena          Json?
  creadoEn        DateTime  @default(now())
  actualizadoEn   DateTime  @updatedAt
  /// El usuario que lo importo por ultima vez (desde la migracion 55, o que
  /// lo cambio a mano en Punto).
  actualizadoPor  String
  /// El flete del proveedor, en % sobre el costo (0 a 100). Se carga en
  /// Punto (migracion 55): volver a importar el Excel no lo toca. Null = sin
  /// flete.
  flete           Float?
  // ---- Migracion 55, V.0.99.82. Damian, 22/11/2026: "dame la posibilidad
  // de editar esos proveedores y tambien eliminar", "que ponga un contacto
  // de vendedor y algun numero de telefono de WhatsApp ... Tambien mail".
  // Lo que sigue lo carga Punto: GBP no lo tiene y el Excel no lo toca.
  /// El vendedor o la persona de contacto del proveedor.
  contacto        String    @default("")
  /// Solo numeros, con un + adelante si se quiere (hasta 20).
  whatsapp        String    @default("")
  /// En minuscula (hasta 120).
  email           String    @default("")
  notas           String    @default("")
  /// Los datos de GBP que se retocaron a mano en Punto: volver a importar
  /// el Excel no los pisa.
  editados        String[]  @default([])
  /// El usuario que lo dio de alta en Punto. Vacio en los que vinieron de GBP.
  creadoPor       String    @default("")
  /// Eliminado en Punto: no se borra, se marca (como PuntoDocumento). Sale
  /// de la lista, se puede restaurar, y el Excel no lo vuelve a cargar.
  eliminadoEn     DateTime?
  eliminadoPor    String?

  @@index([razonSocial])
  @@index([cuit])
}

/// Los pedidos a los proveedores, las ordenes de compra de Punto (OC-0001),
/// migracion 55. Damian, 22/11/2026: "el pedido que voy a pedirle al
/// proveedor me lo pongas con los costos y los valores ... los costos con los
/// descuentos y cuanto es el valor de la mercaderia que le estoy pidiendo", y
/// "cuando hago una orden de pedido y queda algo como pendiente, si me vuelve
/// la semana que viene a sacar faltantes, que quede remarcado que ya esta
/// pedido". Lo escribe src/lib/punto-compras.ts.
model PuntoCompra {
  id            String    @id @default(cuid())
  /// De la serie "n2:compra" de PuntoNumerador: arranca en 1.
  nro           Int
  /// El proveedor de la lista, si se eligio de ahi. Null = solo el nombre.
  proveedorId   String?
  /// La razon social como se ve en el pedido.
  proveedor     String
  /// srl | cnc | tsl
  sucursal      String
  /// abierto | enviado | parcial | recibido | anulado
  estado        String
  /// {cod, tit, cant, recibido, lista, cadena, cont, neto, iva,
  /// sinStockFabrica, origen, bulto?, necesita?}: ver
  /// src/lib/punto-compras-limpiar.ts.
  renglones     Json
  /// Los totales los calcula el servidor, nunca la pagina.
  neto          Float
  iva           Float
  total         Float
  nota          String    @default("")
  /// Sube en cada cambio: dos que guardan el mismo pedido no se pisan.
  version       Int       @default(1)
  creadoPor     String
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
  enviadoEn     DateTime?
  cerradoEn     DateTime?
  /// Las marcas de los ultimos "sumar" que entraron en este pedido (hasta
  /// 30): el reintento de uno que ya entro no suma dos veces.
  marcas        String[]  @default([])

  @@index([estado, sucursal])
  @@index([proveedorId])
}

/// La venta que se esta armando en Punto, y lo que sale de ella antes de
/// emitirse: los borradores, los tickets que esperan en la caja y los
/// pedidos tomados (migracion 55). Damian, 22/11/2026: "Todo tiene que estar
/// en el servidor, nada de en ninguna maquina local, porque se va a leer con
/// varios usuarios en diferentes computadoras y en diferentes lugares", y
/// "que el comprobante pase a un estado de al cajero ... los vendedores no
/// puedan cobrar". Lo escribe src/lib/punto-ventas.ts; el paso a "cobrada"
/// lo hace src/lib/punto-documentos.ts al emitir, en la misma transaccion.
model PuntoVenta {
  id              String    @id @default(cuid())
  creadoEn        DateTime  @default(now())
  actualizadoEn   DateTime  @updatedAt
  /// Sube en cada cambio: dos pestanas o dos puestos que guardan la misma
  /// venta no se pisan (el segundo recibe "conflicto").
  version         Int       @default(1)
  /// armando | borrador | en-caja | cobrando | cobrada | anulada | pedido
  estado          String
  /// Quien la tiene ahora: el vendedor, o el cajero mientras la cobra.
  usuario         String
  /// El nombre del vendedor que sale en el comprobante (la comision es suya
  /// aunque la cobre el cajero) y su usuario.
  vendedor        String
  vendedorUsuario String
  /// srl | cnc | tsl. En caja y cobrando: la caja que la tiene que cobrar.
  sucursal        String
  /// La pestana del navegador de la venta que se esta armando: una abierta
  /// por usuario y pestana. Null en todo lo demas.
  lugar           String?
  /// El cajero que la esta cobrando y desde cuando.
  tomadoPor       String?
  tomadoEn        DateTime?
  /// El comprobante con el que se cobro.
  documentoId     String?
  /// El presupuesto del que salio, si salio de uno.
  origenId        String?
  /// El nombre del cliente y el total como se guardaron (para las listas).
  cliente         String
  total           Float
  /// Lo que arma la pagina: renglones {cod,cant}, articulos a mano, cliente,
  /// descuento, forma de pago, comprobante, deposito, nota y, en un pedido,
  /// ped (entrega, fecha, direccion, sena, estado, nro).
  datos           Json

  @@unique([usuario, lugar])
  @@index([estado, sucursal])
  @@index([usuario, estado])
}

/// Los clientes de Punto, en el servidor (migracion 55): los ve cualquier
/// puesto. Antes vivian en la memoria de cada compu. Lo escribe
/// src/lib/punto-clientes.ts.
model PuntoCliente {
  id            String   @id @default(cuid())
  /// El ID del cliente en GBP, si vino de alla.
  gbpId         Int?     @unique
  /// Solo los 11 numeros, o vacio.
  cuit          String
  dni           String
  nombre        String
  /// Como lo eligio la pagina: "Responsable Inscripto", "Consumidor Final"...
  condicionIva  String
  domicilio     String
  localidad     String
  provincia     String
  telefono      String
  email         String
  /// La lista de precios que le toca ("01.Lista 1"...).
  lista         String
  /// Limite de la cuenta corriente, en pesos. 0 = sin cuenta.
  limite        Float    @default(0)
  /// No se borra: se marca.
  inactivo      Boolean  @default(false)
  creadoPor     String
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([nombre])
  @@index([cuit])
}

/// Las cuentas de plata de cada razon social (migracion 57): el efectivo de
/// la caja, Mercado Pago y cada banco (caja de ahorro o cuenta corriente).
/// El saldo no se guarda: es saldoInicial mas los movimientos no anulados
/// desde `desde` (src/lib/punto-cuentas-reglas.ts). Lo escribe
/// src/lib/punto-cuentas.ts.
model PuntoCuenta {
  id            String            @id @default(cuid())
  /// srl | cnc | tsl
  sucursal      String
  /// efectivo | mercadopago | banco
  tipo          String
  nombre        String
  banco         String            @default("")
  /// ca (caja de ahorro) | cc (cuenta corriente); null si no es banco.
  clase         String?
  saldoInicial  Float             @default(0)
  /// YYYY-MM-DD: desde que dia cuentan los movimientos.
  desde         String
  /// No se borra: se da de baja.
  activa        Boolean           @default(true)
  creadoPor     String
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt
  movimientos   PuntoMovimiento[]

  @@unique([sucursal, nombre])
}

/// Cada hecho de plata en una cuenta (migracion 57): un gasto, un pago a
/// proveedor, un retiro, una cobranza, una sena, un ajuste, o una de las dos
/// patas de un pase entre cuentas (mismo grupo). No se borra: se anula.
model PuntoMovimiento {
  id         String      @id @default(cuid())
  /// Lo genera la pagina al abrir el formulario: el mismo pedido repetido
  /// (doble clic, corte) no se guarda dos veces. Las dos patas de un pase lo
  /// comparten; el unico es con la cuenta.
  idLocal    String
  grupo      String
  fecha      DateTime    @default(now())
  creadoEn   DateTime    @default(now())
  usuario    String
  /// La razon social de la cuenta.
  sucursal   String
  /// gasto | pago-proveedor | retiro | cobranza | sena | transferencia | ajuste
  tipo       String
  cuentaId   String
  cuenta     PuntoCuenta @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  /// + entra a la cuenta, - sale.
  monto      Float
  rubro      String      @default("")
  detalle    String      @default("")
  iva        Float       @default(0)
  /// Un gasto compartido: {"srl":50,"cnc":50}. Null = de la razon social de la cuenta.
  reparto    Json?
  anuladoEn  DateTime?
  anuladoPor String?
  motivo     String?

  @@unique([idLocal, cuentaId])
  @@index([cuentaId, fecha])
  @@index([sucursal, fecha])
  @@index([grupo])
}

/// Los cierres (y la primera apertura) de la caja de efectivo de cada razon
/// social (migracion 58, V.0.11.255). Cada cierre va desde el anterior hasta
/// ese momento; guarda lo de ese momento y no se reescribe. Lo escribe
/// src/lib/punto-cierres.ts.
model PuntoCierre {
  id          String    @id @default(cuid())
  /// Lo genera la pagina: el reintento (doble clic, corte) no cierra dos veces.
  idLocal     String    @unique
  /// srl | cnc | tsl
  sucursal    String
  /// apertura (la primera vez) | cierre
  tipo        String
  /// El cierre anterior (null en la apertura).
  desde       DateTime?
  hasta       DateTime  @default(now())
  /// Con lo que abrio (lo que quedo en el cierre anterior).
  apertura    Float     @default(0)
  /// Cobrado en efectivo en ese tiempo (las notas de credito restan).
  ventas      Float     @default(0)
  /// Movimientos del efectivo (gastos y retiros restan).
  movimientos Float     @default(0)
  esperado    Float
  contado     Float
  /// contado - esperado: negativo falta, positivo sobra.
  diferencia  Float     @default(0)
  /// Lo que se saco al cerrar (al banco, al dueño).
  retiro      Float     @default(0)
  destino     String    @default("")
  /// Con lo que abre el siguiente: contado - retiro.
  queda       Float
  /// {"20000": 12, ..., "monedas": 1350}
  billetes    Json
  nota        String    @default("")
  usuario     String
  creadoEn    DateTime  @default(now())
  /// Reset desde Gerencia (migracion 59, V.0.11.256): no se borra, deja de
  /// contar. Damian: "poneme un reset pero solo en gerencia, ahora vamos a
  /// completar a modo de ejemplo".
  reseteadoEn  DateTime?
  reseteadoPor String?

  @@index([sucursal, hasta])
}

/// La agenda de pagos a proveedores (migracion 60, V.0.11.257). Damian,
/// 24/11/2026: "necesito en proveedores agendas de pago y setearlas con
/// fechas y que me avise el sistema que tengo que realizar pagos". Se carga a
/// mano; al pagarlo se anota (si se elige una cuenta) un PuntoMovimiento
/// "pago-proveedor". No se borra: se anula. Ver src/lib/punto-pagos.ts.
model PuntoPago {
  id            String    @id @default(cuid())
  /// La marca de la carga (la genera la pagina): las cuotas de una misma
  /// carga la comparten, y la misma carga repetida no se guarda dos veces.
  grupo         String
  cuota         Int       @default(1)
  cuotas        Int       @default(1)
  /// El proveedor de la lista, si se eligio de ahi. Null = solo el nombre.
  proveedorId   String?
  proveedor     String
  /// srl | cnc | tsl: la razon social que paga.
  sucursal      String
  concepto      String    @default("")
  monto         Float
  /// YYYY-MM-DD
  vence         String
  /// transferencia | efectivo | cheque | echeq | otro | "" (sin decir)
  forma         String    @default("")
  /// Cuantos dias antes del vencimiento empieza a avisar.
  avisar        Int       @default(3)
  nota          String    @default("")
  /// pendiente | pagado | anulado
  estado        String    @default("pendiente")
  /// Sube en cada cambio: dos que tocan el mismo pago no se pisan.
  version       Int       @default(1)
  creadoPor     String
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
  /// YYYY-MM-DD en que se pago.
  pagadoDia     String?
  pagadoEn      DateTime?
  pagadoPor     String?
  montoPagado   Float?
  /// La cuenta de donde salio (null = se marco sin anotarlo en una cuenta).
  cuentaId      String?
  /// La marca del pago: el idLocal (y el grupo) del movimiento en la cuenta.
  marcaPago     String?
  anuladoEn     DateTime?
  anuladoPor    String?
  motivo        String?

  @@unique([grupo, cuota])
  @@index([estado, vence])
}

/// Lo que piden los clientes y no tenemos (migracion 61, V.0.11.260). Daniel,
/// 25/11/2026: "en la parte de vender o presupuestar ... un boton que diga
/// notas donde yo pueda ingresar una nota de texto o voz donde sugiera algun
/// producto que me piden los clientes ... agruparlos a todos que aparezcan en
/// algun lado donde la gerencia hace los pedidos". Lo anota el vendedor; lo
/// ve gerencia en Proveedores, agrupado. No se borra: se resuelve.
model PuntoNotaCliente {
  id          String    @id @default(cuid())
  /// La genera la pagina: la misma nota repetida no se guarda dos veces.
  idLocal     String    @unique
  texto       String
  /// Se dicto con el microfono.
  porVoz      Boolean   @default(false)
  cantidad    Int?
  /// El cliente de la venta, si no era consumidor final.
  cliente     String    @default("")
  /// srl | cnc | tsl
  sucursal    String
  usuario     String
  creadoEn    DateTime  @default(now())
  /// nueva | pedida | descartada
  estado      String    @default("nueva")
  resueltoEn  DateTime?
  resueltoPor String?
  /// Por que se descarto ("lo tenemos", "no se consigue"...) o que se pidio.
  motivo      String    @default("")

  @@index([estado, creadoEn])
}
