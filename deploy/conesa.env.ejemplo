# Claves de la tienda en la VM. Se copia a /etc/conesa.env, que solo puede
# leer root (chmod 600), y lo leen el servicio y el script de actualizacion.
#
# ESTE ARCHIVO ES EL EJEMPLO: no lleva ningun valor real y si va al
# repositorio. El de verdad vive en /etc/conesa.env y nunca se sube.
#
# Ojo: las que empiezan con NEXT_PUBLIC_ se graban dentro de la pagina al
# compilar, asi que si se cambia una hay que volver a correr actualizar.sh.

# --- Base de datos ----------------------------------------------------
# La completa solo setup-vm.sh con la contrasena que genera.
DATABASE_URL="postgresql://conesa:CAMBIAR@localhost:5432/conesa"

# --- Panel de administracion ------------------------------------------
# ROTAR las dos por el incidente de Railway del 21/10/2026.
ADMIN_PASSWORD=
# 32 caracteres o mas. Para generar una:  openssl rand -base64 32
ADMIN_COOKIE_SECRET=

# --- Direccion publica ------------------------------------------------
SITE_URL=https://conesa.com.ar
NODE_ENV=production

# --- MercadoPago ------------------------------------------------------
# ROTAR: es la plata. Se saca de mercadopago.com.ar/developers
MP_ACCESS_TOKEN=

# --- Mails (Resend) ---------------------------------------------------
# ROTAR.
RESEND_API_KEY=
MAIL_FROM="Sanitarios Conesa <pedidos@conesa.com.ar>"

# --- Analitica --------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=1456278909900822
NEXT_PUBLIC_CF_BEACON=

# --- Datos fiscales que se muestran en la pagina ----------------------
NEXT_PUBLIC_RAZON_SOCIAL="CONESA CARLOS DANIEL"
NEXT_PUBLIC_CUIT=20-27587068-5
NEXT_PUBLIC_IIBB=
NEXT_PUBLIC_INICIO_ACTIVIDADES=

# --- Facturacion electronica ARCA -------------------------------------
# Estas dos NO se escriben a mano: las cargan los scripts arca-*.sh, que
# ademas comprueban que el certificado y la clave sean par antes de guardar.
#
# Van en base64, en una sola linea (asi lo lee src/lib/afip/config.ts). La
# clave privada no sale nunca de este servidor: con ella un tercero podria
# emitir facturas con el CUIT de Carlos. Por eso /etc/conesa.env es 600 y
# por eso no se mudo desde Railway sino que se genero de cero aca.
AFIP_CUIT=20275870685
AFIP_PTO_VTA=6
AFIP_ENV=homologacion
AFIP_CERT=
AFIP_KEY=
NEXT_PUBLIC_AFIP_QR=

# --- IA (Gemini) ------------------------------------------------------
# ROTAR.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash-lite

# --- Respaldo afuera de la VM -----------------------------------------
# Nombre del deposito de Google Cloud Storage donde backup.sh sube la copia
# de cada noche. Sin esto, el respaldo queda solo en el disco de la VM y se
# pierde junto con ella.
BUCKET=
