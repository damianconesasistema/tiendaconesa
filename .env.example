# Base de datos
# Dev local (SQLite):
DATABASE_URL="file:./dev.db"
# Produccion Railway (Postgres): se setea desde Railway Variables.
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# Admin login (set en Railway Variables)
ADMIN_PASSWORD=cambiame
ADMIN_COOKIE_SECRET=generar-string-random-de-32-caracteres-minimo

# Clave de la demo /sistema/demo (solo en el servidor, /etc/conesa.env).
# Si no esta puesta, /sistema/demo contesta "no encontrado".
DEMO_PASSWORD=
